function nextStep(num){

    document.querySelectorAll(".form-step").forEach(x=>{
        x.classList.remove("active");
    });

    document.querySelector("#step"+num).classList.add("active");

    for(let i=1;i<=5;i++){
        document.querySelector("#s"+i).classList.remove("active");
    }

    document.querySelector("#s"+num).classList.add("active");

}


