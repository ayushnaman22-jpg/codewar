        ["Matching interests...","Finding relevant project domains."],
        ["Checking feasibility...","Evaluating time, budget and complexity."],
        ["Designing architecture...","Building your technical blueprint."],
        ["Evaluating innovation...","Checking uniqueness and resume value."],
        ["Building your roadmap...","Creating your development plan."]
    ];

    let i=0;

    const interval=setInterval(()=>{

        title.textContent=stages[i][0];
        text.textContent=stages[i][1];

        i++;

        if(i>=stages.length){

            clearInterval(interval);

            setTimeout(()=>{

                loader.style.display="none";

                document.querySelector("#result").style.display="block";

                document.querySelector("#result").scrollIntoView({
                    behavior:"smooth"
                });

            },600);

