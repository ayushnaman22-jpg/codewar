<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ProjectForge AI — Build Your Next Big Project</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

:root{
    --bg:#07080d;
    --card:#10121a;
    --card2:#151823;
    --border:#252938;
    --text:#f5f7ff;
    --muted:#8f96aa;
    --purple:#8b5cf6;
    --cyan:#22d3ee;
    --blue:#3b82f6;
    --green:#22c55e;
}

body{
    font-family:Inter,sans-serif;
    background:
      radial-gradient(circle at 80% 10%,rgba(139,92,246,.13),transparent 30%),
      radial-gradient(circle at 10% 70%,rgba(34,211,238,.07),transparent 25%),
      var(--bg);
    color:var(--text);
    min-height:100vh;
}

button,input,select,textarea{
    font:inherit;
}

button{
    cursor:pointer;
}

a{
    color:inherit;
    text-decoration:none;
}

::-webkit-scrollbar{
    width:7px;
}

::-webkit-scrollbar-thumb{
    background:#292d3c;
    border-radius:20px;
}

/* NAVBAR */

.navbar{
    position:fixed;
    top:0;
    left:0;
    right:0;
    height:72px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 6%;
    background:rgba(7,8,13,.75);
    backdrop-filter:blur(18px);
    border-bottom:1px solid rgba(255,255,255,.06);
    z-index:1000;
}

.logo{
    display:flex;
    align-items:center;
    gap:10px;
    font-weight:800;
    font-size:19px;
}

.logo-icon{
    width:34px;
    height:34px;
    border-radius:10px;
    display:grid;
    place-items:center;
    background:linear-gradient(135deg,var(--purple),var(--cyan));
    box-shadow:0 0 25px rgba(139,92,246,.35);
}

.nav-links{
    display:flex;
    gap:28px;
    color:var(--muted);
    font-size:14px;
}

.nav-links a:hover{
    color:white;
}

.nav-actions{
    display:flex;
    gap:10px;
}

/* BUTTONS */

.btn{
    border:0;
    border-radius:10px;
    padding:12px 18px;
    color:white;
    font-weight:600;
    transition:.25s;
}

.btn:hover{
    transform:translateY(-2px);
}

.btn-primary{
    background:linear-gradient(135deg,var(--purple),var(--blue));
    box-shadow:0 10px 35px rgba(139,92,246,.25);
}

.btn-secondary{
    background:#171a25;
    border:1px solid var(--border);
}

.btn-cyan{
    background:linear-gradient(135deg,#0891b2,var(--cyan));
}

/* HERO */

.hero{
    min-height:100vh;
    padding:150px 7% 80px;
    display:grid;
    grid-template-columns:1.05fr .95fr;
    gap:70px;
    align-items:center;
    max-width:1500px;
    margin:auto;
}

.badge{
    display:inline-flex;
    padding:8px 13px;
    border:1px solid rgba(139,92,246,.3);
    background:rgba(139,92,246,.08);
    border-radius:30px;
    color:#c4b5fd;
    font-size:13px;
    margin-bottom:25px;
}

.hero h1{
    font-size:clamp(42px,6vw,76px);
    line-height:1.02;
    letter-spacing:-4px;
    margin-bottom:25px;
}

.gradient-text{
    background:linear-gradient(90deg,#fff,#a78bfa,#67e8f9);
    -webkit-background-clip:text;
    color:transparent;
}

.hero p{
    color:var(--muted);
    font-size:17px;
    line-height:1.8;
    max-width:680px;
}

.hero-buttons{
    display:flex;
    gap:12px;
    margin-top:30px;
    flex-wrap:wrap;
}

/* AI VISUAL */

.ai-visual{
    position:relative;
    height:510px;
    border:1px solid var(--border);
    background:linear-gradient(145deg,rgba(20,23,34,.9),rgba(8,9,15,.9));
    border-radius:28px;
    padding:25px;
    overflow:hidden;
    box-shadow:0 30px 100px rgba(0,0,0,.35);
}

.grid{
    position:absolute;
    inset:0;
    opacity:.15;
    background-image:
      linear-gradient(#fff 1px,transparent 1px),
      linear-gradient(90deg,#fff 1px,transparent 1px);
    background-size:35px 35px;
}

.ai-center{
    position:absolute;
    left:50%;
    top:50%;
    transform:translate(-50%,-50%);
    width:130px;
    height:130px;
    border-radius:50%;
    display:grid;
    place-items:center;
    background:linear-gradient(135deg,var(--purple),var(--cyan));
    box-shadow:0 0 90px rgba(139,92,246,.45);
    font-size:42px;
    animation:pulse 3s infinite;
}

.node{
    position:absolute;
    padding:13px 18px;
    border-radius:12px;
    border:1px solid #303545;
    background:rgba(18,20,30,.9);
    backdrop-filter:blur(10px);
    font-size:13px;
}

.node span{
    display:block;
    color:var(--muted);
    margin-top:5px;
    font-size:11px;
}

.n1{top:55px;left:35px}
.n2{top:60px;right:35px}
.n3{bottom:65px;left:40px}
.n4{bottom:60px;right:40px}

@keyframes pulse{
    50%{transform:translate(-50%,-50%) scale(1.08)}
}

/* METRICS */

.metrics{
    max-width:1200px;
    margin:-20px auto 100px;
    padding:0 20px;
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:15px;
}

.metric{
    padding:25px;
    background:rgba(16,18,26,.7);
    border:1px solid var(--border);
    border-radius:18px;
}

.metric strong{
    display:block;
    font-size:28px;
    margin-bottom:8px;
}

.metric span{
    color:var(--muted);
    font-size:13px;
}

/* SECTIONS */

.section{
    max-width:1200px;
    margin:auto;
    padding:90px 20px;
}

.section-title{
    margin-bottom:35px;
}

.section-title small{
    color:#a78bfa;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:2px;
}

.section-title h2{
    font-size:40px;
    margin-top:10px;
    letter-spacing:-1px;
}

.section-title p{
    color:var(--muted);
    margin-top:10px;
}

/* GENERATOR */

.generator{
    background:linear-gradient(145deg,#11131d,#0b0d13);
    border:1px solid var(--border);
    border-radius:25px;
    padding:35px;
}

.steps{
    display:grid;
    grid-template-columns:repeat(5,1fr);
    gap:8px;
    margin-bottom:35px;
}

.step{
    padding:13px;
    text-align:center;
    border-radius:10px;
    color:var(--muted);
    background:#151822;
    font-size:12px;
}

.step.active{
    background:rgba(139,92,246,.18);
    color:#c4b5fd;
    border:1px solid rgba(139,92,246,.4);
}

.form-step{
    display:none;
}

.form-step.active{
    display:block;
    animation:fade .3s;
}

@keyframes fade{
    from{opacity:0;transform:translateY(8px)}
    to{opacity:1;transform:translateY(0)}
}

.form-grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:18px;
}

.field label{
    display:block;
    margin-bottom:8px;
    font-size:13px;
    color:#c4c9d7;
}

input,select,textarea{
    width:100%;
    padding:14px;
    background:#0b0d13;
    border:1px solid var(--border);
    color:white;
    border-radius:10px;
    outline:none;
}

input:focus,select:focus,textarea:focus{
    border-color:var(--purple);
}

textarea{
    resize:vertical;
    min-height:100px;
}

.chips{
    display:flex;
    flex-wrap:wrap;
    gap:9px;
}

.chip{
    padding:10px 14px;
    border-radius:9px;
    border:1px solid var(--border);
    background:#121520;
    color:#aeb4c5;
    cursor:pointer;
    font-size:12px;
    transition:.2s;
}

.chip:hover,
.chip.selected{
    background:rgba(139,92,246,.17);
    border-color:var(--purple);
    color:white;
}

.form-actions{
    margin-top:30px;
    display:flex;
    justify-content:space-between;
}

/* RESULT */

#result{
    display:none;
}

.project-header{
    padding:35px;
    border:1px solid var(--border);
    border-radius:24px;
    background:linear-gradient(145deg,#131624,#0d0f17);
    margin-bottom:20px;
}

.project-header h2{
    font-size:42px;
    margin:15px 0;
}

.project-header p{
    color:var(--muted);
    line-height:1.7;
    max-width:800px;
}

.tags{
    display:flex;
    flex-wrap:wrap;
    gap:8px;
}

.tag{
    padding:7px 11px;
    border-radius:20px;
    font-size:11px;
    background:#191c28;
    color:#b9c0d3;
    border:1px solid var(--border);
}

/* DASHBOARD GRID */

.dashboard-grid{
    display:grid;
    grid-template-columns:1.1fr .9fr;
    gap:20px;
}

.card{
    background:rgba(16,18,26,.85);
    border:1px solid var(--border);
    border-radius:20px;
    padding:25px;
}

.card h3{
    margin-bottom:20px;
}

.card p{
    color:var(--muted);
    line-height:1.7;
    font-size:14px;
}

.score{
    display:flex;
    align-items:center;
    gap:25px;
}

.circle{
    width:130px;
    height:130px;
    border-radius:50%;
    display:grid;
    place-items:center;
    background:
      radial-gradient(circle at center,#10121a 55%,transparent 56%),
      conic-gradient(var(--purple) 0 91%,#242735 91%);
}

.circle strong{
    font-size:30px;
}

.score-list{
    flex:1;
}

.score-row{
    display:flex;
    justify-content:space-between;
    font-size:12px;
    margin:12px 0;
}

.progress{
    height:5px;
    background:#252936;
    border-radius:10px;
    overflow:hidden;
    margin-top:5px;
}

.progress div{
    height:100%;
    background:linear-gradient(90deg,var(--purple),var(--cyan));
    border-radius:10px;
}

/* FEATURE CARDS */

.features{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:12px;
}

.feature{
    padding:18px;
    background:#131620;
    border:1px solid var(--border);
    border-radius:14px;
}

.feature-icon{
    font-size:24px;
    margin-bottom:12px;
}

.feature h4{
    margin-bottom:7px;
}

.feature p{
    font-size:12px;
}

.status{
    display:inline-block;
    margin-top:12px;
    font-size:10px;
    padding:5px 8px;
    border-radius:5px;
    background:rgba(34,197,94,.12);
    color:#86efac;
}

/* DNA */

.dna{
    display:grid;
    gap:16px;
}

.dna-row{
    display:grid;
    grid-template-columns:120px 1fr 45px;
    align-items:center;
    gap:10px;
    font-size:12px;
}

.dna-bar{
    height:8px;
    border-radius:10px;
    background:#242734;
    overflow:hidden;
}

.dna-bar div{
    height:100%;
    background:linear-gradient(90deg,var(--purple),var(--cyan));
}

/* ARCHITECTURE */

.architecture{
    display:flex;
    align-items:center;
    justify-content:center;
    flex-wrap:wrap;
    gap:10px;
    padding:25px 0;
}

.arch-node{
    padding:17px 22px;
    border:1px solid #353a4b;
    border-radius:12px;
    background:#171a25;
    text-align:center;
}

.arch-node small{
    display:block;
    color:var(--muted);
    margin-top:5px;
}

.arrow{
    color:#777f96;
    font-size:25px;
}

/* ROADMAP */

.timeline{
    border-left:2px solid #292d3b;
    margin-left:15px;
    padding-left:25px;
}

.phase{
    position:relative;
    margin-bottom:28px;
}

.phase:before{
    content:"";
    position:absolute;
    left:-34px;
    top:4px;
    width:13px;
    height:13px;
    border-radius:50%;
    background:var(--purple);
    box-shadow:0 0 15px rgba(139,92,246,.7);
}

.phase h4{
    margin-bottom:6px;
}

.phase span{
    color:#a78bfa;
    font-size:11px;
}

.phase p{
    margin-top:6px;
}

/* MENTOR */

.mentor{
    display:grid;
    grid-template-rows:1fr auto;
    height:420px;
}

.chat{
    overflow:auto;
    display:flex;
    flex-direction:column;
    gap:12px;
}

.message{
    max-width:80%;
    padding:12px 15px;
    border-radius:12px;
    font-size:13px;
    line-height:1.6;
}

.bot{
    background:#171a25;
    color:#cdd2df;
    align-self:flex-start;
}

.user{
    background:linear-gradient(135deg,#6941c6,#345fd1);
    align-self:flex-end;
}

.chat-input{
    display:flex;
    gap:8px;
    margin-top:15px;
}

/* TOOLS */

.tools{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:15px;
}

.tool{
    padding:22px;
    background:#131620;
    border:1px solid var(--border);
    border-radius:16px;
}

.tool button{
    margin-top:15px;
}

/* MODAL */

.modal{
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.75);
    backdrop-filter:blur(8px);
    display:none;
    align-items:center;
    justify-content:center;
    z-index:2000;
    padding:20px;
}

.modal-box{
    width:600px;
    max-width:100%;
    background:#11141d;
    border:1px solid var(--border);
    border-radius:22px;
    padding:30px;
    max-height:80vh;
    overflow:auto;
}

.modal-box h2{
    margin-bottom:15px;
}

.modal-box p{
    color:var(--muted);
    line-height:1.8;
    white-space:pre-line;
}

/* LOADER */

.loader{
    position:fixed;
    inset:0;
    background:#07080d;
    z-index:3000;
    display:none;
    align-items:center;
    justify-content:center;
    flex-direction:column;
}

.loader-orb{
    width:90px;
    height:90px;
    border-radius:50%;
    background:linear-gradient(135deg,var(--purple),var(--cyan));
    box-shadow:0 0 80px rgba(139,92,246,.6);
    animation:pulse 1.2s infinite;
    margin-bottom:30px;
}

.loader h2{
    margin-bottom:12px;
}

.loader p{
    color:var(--muted);
}

footer{
    border-top:1px solid var(--border);
    text-align:center;
    padding:35px;
    color:var(--muted);
    font-size:12px;
}

/* RESPONSIVE */

@media(max-width:900px){
    .hero{
        grid-template-columns:1fr;
        padding-top:120px;
    }

    .nav-links{
        display:none;
    }

    .metrics{
        grid-template-columns:repeat(2,1fr);
    }

    .dashboard-grid{
        grid-template-columns:1fr;
    }

    .features,
    .tools{
        grid-template-columns:repeat(2,1fr);
    }
}

@media(max-width:600px){
    .navbar{
        padding:0 18px;
    }

    .nav-actions .btn-secondary{
        display:none;
    }

    .hero{
        padding:110px 18px 50px;
    }

    .hero h1{
        font-size:43px;
        letter-spacing:-2px;
    }

    .ai-visual{
        height:390px;
    }

    .node{
        font-size:10px;
    }

    .metrics{
        grid-template-columns:1fr 1fr;
        margin-bottom:30px;
    }

    .section{
        padding:55px 15px;
    }

    .generator{
        padding:18px;
    }

    .steps{
        grid-template-columns:repeat(5,1fr);
    }

    .step{
        font-size:9px;
        padding:9px 3px;
    }

    .form-grid{
        grid-template-columns:1fr;
    }

    .features,
    .tools{
        grid-template-columns:1fr;
    }

    .project-header h2{
        font-size:30px;
    }

    .score{
        flex-direction:column;
        align-items:flex-start;
    }

    .dna-row{
        grid-template-columns:90px 1fr 35px;
    }
}
</style>
</head>

<body>

<!-- NAVBAR -->

<nav class="navbar">
    <a href="#" class="logo">
        <span class="logo-icon">⚡</span>
        ProjectForge AI
    </a>

    <div class="nav-links">
        <a href="#generator">Generate</a>
        <a href="#result">Workspace</a>
        <a href="#mentor">AI Mentor</a>
        <a href="#tools">Tools</a>
    </div>

    <div class="nav-actions">
        <button class="btn btn-secondary" onclick="demo()">Try Demo</button>
        <button class="btn btn-primary" onclick="startGenerator()">Generate</button>
    </div>
</nav>


<!-- HERO -->

<section class="hero">

    <div>
        <div class="badge">✦ AI-Powered Project Architecture</div>

        <h1>
            Your Skills.<br>
            Your Interests.<br>
            <span class="gradient-text">Your Next Big Project.</span>
        </h1>

        <p>
            ProjectForge AI transforms your skills and interests into
            practical, innovative and buildable projects—with architecture,
            technology choices, features and a complete development roadmap.
        </p>

        <div class="hero-buttons">
            <button class="btn btn-primary" onclick="startGenerator()">
                Generate My Project →
            </button>

            <button class="btn btn-secondary" onclick="demo()">
                ▶ Try Live Demo
            </button>
        </div>
    </div>


    <div class="ai-visual">

        <div class="grid"></div>

        <div class="node n1">
            🧠 YOUR SKILLS
            <span>Python • AI/ML • JS</span>
        </div>

        <div class="node n2">
            💡 INTERESTS
            <span>AI • Cyber • EdTech</span>
        </div>

        <div class="node n3">
            🏗 ARCHITECTURE
            <span>API • Database • ML</span>
        </div>

        <div class="node n4">
            🚀 ROADMAP
            <span>50 Day Build Plan</span>
        </div>

        <div class="ai-center">⚡</div>

    </div>

</section>


<!-- METRICS -->

<div class="metrics">

    <div class="metric">
        <strong>10K+</strong>
        <span>Project Concepts</span>
    </div>

    <div class="metric">
        <strong>50+</strong>
        <span>Technology Domains</span>
    </div>

    <div class="metric">
        <strong>AI-Powered</strong>
        <span>Project Guidance</span>
    </div>

    <div class="metric">
        <strong>End-to-End</strong>
        <span>Development Roadmaps</span>
    </div>

</div>


<!-- GENERATOR -->

<section class="section" id="generator">

    <div class="section-title">
        <small>Project Generator</small>
        <h2>Turn your skills into a project.</h2>
        <p>Tell Forge about yourself. We'll build the blueprint.</p>
    </div>

    <div class="generator">

        <div class="steps">
            <div class="step active" id="s1">01 Profile</div>
            <div class="step" id="s2">02 Interests</div>
            <div class="step" id="s3">03 Skills</div>
            <div class="step" id="s4">04 Constraints</div>
            <div class="step" id="s5">05 Generate</div>
        </div>


        <!-- STEP 1 -->

        <div class="form-step active" id="step1">

            <div class="form-grid">

                <div class="field">
                    <label>Your Name</label>
                    <input id="name" placeholder="Enter your name">
                </div>

                <div class="field">
                    <label>Degree</label>
                    <select id="degree">
                        <option>B.Tech</option>
                        <option>BCA</option>
                        <option>MCA</option>
                        <option>Other</option>
                    </select>
                </div>

                <div class="field">
                    <label>Branch</label>
                    <select id="branch">
                        <option>CSE AI/ML</option>
                        <option>CSE</option>
                        <option>IT</option>
                        <option>ECE</option>
                        <option>Other</option>
                    </select>
                </div>

                <div class="field">
                    <label>Year</label>
                    <select id="year">
                        <option>2nd Year</option>
                        <option>3rd Year</option>
                        <option>Final Year</option>
                    </select>
                </div>

                <div class="field">
                    <label>Team Size</label>
                    <select id="team">
                        <option>Solo</option>
                        <option>2</option>
                        <option>3</option>
                        <option>4+</option>
                    </select>
                </div>

            </div>

            <div class="form-actions">
                <span></span>
                <button class="btn btn-primary" onclick="nextStep(2)">
                    Continue →
                </button>
            </div>

        </div>


        <!-- STEP 2 -->

        <div class="form-step" id="step2">

            <h3>Select your interests</h3>

            <br>

            <div class="chips">

                <div class="chip">AI / ML</div>
                <div class="chip">Generative AI</div>
                <div class="chip">Computer Vision</div>
                <div class="chip">NLP</div>
                <div class="chip">Cybersecurity</div>
                <div class="chip">Web Development</div>
                <div class="chip">App Development</div>
                <div class="chip">IoT</div>
                <div class="chip">Robotics</div>
                <div class="chip">Cloud</div>
                <div class="chip">Data Science</div>
                <div class="chip">FinTech</div>
                <div class="chip">EdTech</div>
                <div class="chip">HealthTech</div>
                <div class="chip">AgriTech</div>
                <div class="chip">Sustainability</div>

            </div>

            <br>

            <label>Describe your own idea or interest</label>

            <textarea id="customIdea"
            placeholder="Example: I want to build something using AI that helps students..."></textarea>

