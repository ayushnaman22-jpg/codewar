/* MENTOR */

function askMentor(){

    const input=document.querySelector("#mentorInput");
    const chat=document.querySelector("#chat");

    const question=input.value.trim();

    if(!question) return;

    const user=document.createElement("div");

    user.className="message user";
    user.textContent=question;

    chat.appendChild(user);

    input.value="";

    setTimeout(()=>{

        const bot=document.createElement("div");

        bot.className="message bot";

        let answer=
        "Start with the MVP. Build the simplest working version first, then add advanced AI features.";

        if(question.toLowerCase().includes("database")){
            answer=
            "Use PostgreSQL. Start with Users, Projects, Tasks, Models and Progress tables. Keep relationships simple for the MVP.";
        }

        if(question.toLowerCase().includes("fastapi")){
            answer=
            "FastAPI is a strong choice because it is lightweight, Python-based and integrates naturally with your ML model.";
        }

        if(question.toLowerCase().includes("accuracy")){
            answer=
            "First inspect your dataset and class balance. Then establish a baseline model, evaluate precision/recall/F1 and improve feature engineering before changing algorithms.";
        }

        if(question.toLowerCase().includes("unique")){
            answer=
            "Add explainable AI, project evolution, uniqueness scoring and an AI judge. These features make your project more than a simple recommendation system.";
        }

        bot.textContent=answer;

        chat.appendChild(bot);

        chat.scrollTop=chat.scrollHeight;

    },700);

}


